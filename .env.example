# API key from the hackathon registration (Startup plan). Copy this file to .env; never commit .env.
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
# Maximum number of CMC credits a single run may consume
CMC_CREDIT_BUDGET=500
# Lifetime of the local response cache, in seconds: prices and quotes
CACHE_TTL_SECONDS=300
# Lifetime of cached identifiers and metadata (symbol map, token contracts, RWA map), in seconds
CACHE_STATIC_TTL_SECONDS=86400
# Timeout of one API call in milliseconds, and retries after a timeout, a network error, HTTP 5xx or a rate limit
CMC_TIMEOUT_MS=8000
CMC_MAX_RETRIES=2
# Directory of the response cache (empty: .cache/cmc in the project)
CMC_CACHE_DIR=
