{
  "name": "second-opinion",
  "version": "0.1.0",
  "description": "A trust layer on top of the CoinMarketCap API: cross-checks sources, scores data reliability and returns a verdict with evidence.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "bash scripts/check-env.sh",
    "check:clean": "bash scripts/clean-install-check.sh",
    "prepare": "bash scripts/install-hooks.sh",
    "record": "npm run build && node --env-file=.env dist/cli/record.js",
    "call": "npm run build && node dist/cli/call.js",
    "check": "npm run build && node dist/cli/check.js",
    "demo": "npm run build && node dist/demo/run.js",
    "calibrate": "npm run build && node dist/cli/calibrate.js",
    "audit": "npm run build && node dist/cli/audit.js",
    "mcp": "node dist/mcp/server.js",
    "rwa:index": "npm run build && node dist/cli/rwa-index.js",
    "web:install": "npm install --prefix web",
    "web:dev": "npm run build && npm run dev --prefix web",
    "web:build": "npm run build && npm run build --prefix web",
    "web:start": "npm run start --prefix web",
    "web:lint": "npm run lint --prefix web",
    "web:typecheck": "npm run typecheck --prefix web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
